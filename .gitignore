# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# OmniRoute source — cloned into place by the CI workflows (see .github/workflows)
/source/

# Embedded Node runtime — placed by scripts/fetch-node-runtime.mjs.
# The .so is ~18 MB per ABI and is downloaded during the build, not committed;
# the generated APK is verified to contain it (scripts/assert-apk-runtime.mjs).
/modules/node-runtime/android/src/main/jniLibs/
/modules/node-runtime/android/src/main/cpp/include/
